# Copy to .env.local and adjust.
#
# The browser never calls the API directly: requests go through the Next.js BFF
# under src/app/api, so there is no NEXT_PUBLIC_* API URL on purpose.
#
# Ports: web console 3001, API 8010. Both are offset because 3000 and 8000
# are already used by other projects on this machine.
APP_URL=http://localhost:3001
API_BASE_URL=http://127.0.0.1:8010

# WebSocket trace endpoint (daphne). Public: the token is minted per run.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8010
